{
  "name": "rtg-language",
  "displayName": "RtG-Language",
  "description": "Language support for RtG-Language 2.0 source files.",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "rtg-language",
      "aliases": ["RtG-Language", "rtg"],
      "extensions": [".rtg"],
      "configuration": "./extension/language-configuration.json",
      "icon": { "light": "./extension/icons/rtg-file.svg", "dark": "./extension/icons/rtg-file.svg" }
    }],
    "grammars": [{ "language": "rtg-language", "scopeName": "source.rtg", "path": "./extension/syntaxes/rtg-language.tmLanguage.json" }],
    "snippets": [{ "language": "rtg-language", "path": "./extension/snippets/rtg-language.json" }]
  }
}
